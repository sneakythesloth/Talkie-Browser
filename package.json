{
  "name": "talkie-browser",
  "version": "0.3.0",
  "private": true,
  "description": "A rough but working Chromium desktop browser with an AI workspace planned.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "start:mac": "npm run build:ui && electron .",
    "build:ui": "vite build",
    "dev:ui": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
